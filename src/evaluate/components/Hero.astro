---
/* The first screen: who the page is for, the name, the claim, two doors and
 * what the primary one costs - and a screenshot where the front door has its
 * mark, because the reader of this page will not open the playground to see
 * an app. Width and height are the file's, so nothing moves when it lands. */
interface Action { text: string; href: string; primary?: boolean }
interface Props {
  name: string;
  title: string;
  note: string;
  actions: Action[];
  image: { src: string; alt: string; width: number; height: number };
}
const { name, title, note, actions, image } = Astro.props;
---
<section class="hero">
  <div class="hero-main">
    <p class="hero-name">{name}</p>
    <h1 class="hero-text">{title}</h1>
    <p class="hero-tagline"><slot /></p>
    <div class="hero-actions">
      {actions.map((a) => <a class:list={["hero-action", a.primary ? "primary" : "plain"]} href={a.href}>{a.text}</a>)}
    </div>
    <p class="hero-note">{note}</p>
  </div>
  <div class="hero-shot">
    <img src={image.src} alt={image.alt} width={image.width} height={image.height} decoding="async" fetchpriority="high">
  </div>
</section>
