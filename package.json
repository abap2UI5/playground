{
  "name": "abap2ui5-playground",
  "private": true,
  "version": "0.1.0",
  "description": "Browser playground for abap2UI5 - ABAP in the editor, the running app next to it, nothing but a static page.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deps": "node tools/fetch-deps.mjs",
    "build:framework": "node tools/build-framework.mjs",
    "build:ui5": "node tools/build-ui5.mjs",
    "build:site": "node tools/build-site.mjs",
    "build": "node tools/build.mjs",
    "check:size": "node tools/check-size.mjs",
    "check": "npm run build && npm run check:size && npm test",
    "test": "playwright test",
    "serve": "node tools/serve.mjs",
    "build:catalogue": "node tools/build-catalogue.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test:unit": "node --test \"tests/node/*.test.mjs\""
  },
  "devDependencies": {
    "@abap2ui5/linter": "0.9.0",
    "@abaplint/cli": "2.120.75",
    "@abaplint/core": "2.120.75",
    "@abaplint/database-sqlite": "2.13.83",
    "@abaplint/monaco": "2.120.75",
    "@abaplint/runtime": "2.14.3",
    "@abaplint/transpiler": "2.14.3",
    "@abaplint/transpiler-cli": "2.14.3",
    "@anthropic-ai/sdk": "0.133.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@ui5/cli": "4.0.71",
    "@xmldom/xmldom": "0.9.12",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.12.0",
    "monaco-editor": "0.57.0",
    "sql.js": "1.14.2",
    "typescript": "6.0.3"
  }
}
